#!name=哔哩哔哩去廣告
#!desc=擋開屏廣告、首頁與豎屏信息流的廣告卡、搜尋框填充詞、影視頁推廣、直播間帶貨，以及廣告網域。腳本存放在本倉庫、固定在審核過的提交；改自 zirawell/R-Store（GPL-3.0）。不改帳號狀態、不解鎖任何付費功能。
#!category=去廣告

[Rule]
DOMAIN-SUFFIX,ad.bilibili.com,REJECT
DOMAIN-SUFFIX,adcommon.bilibili.com,REJECT
DOMAIN-SUFFIX,cm.game.bilibili.com,REJECT
DOMAIN-SUFFIX,track.biligame.bilibili.com,REJECT
DOMAIN,adtrack.qianwen.com,REJECT
DOMAIN,ad-api.morefreegame.com,REJECT

[Map Local]
# 直播間帶貨、搜尋框填充詞、影視頁活動投放、彈幕滿意度調查、開屏靜態素材：都回空的 JSON
^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v\d\/ecommerce-user\/get_shopping_info\? data-type=json data="{}" status-code=200
^https?:\/\/app\.bilibili\.com\/bilibili\.app\.interface\.v\d\.Search\/DefaultWords data-type=json data="{}" status-code=200
^https?:\/\/api\.bilibili\.com\/pgc\/activity\/deliver data-type=json data="{}" status-code=200
^https?:\/\/api\.bilibili\.com\/x\/v2\/dm\/qoe\/show\? data-type=json data="{}" status-code=200
^https?:\/\/upos-sz-static\.bilivideo\.com\/ssaxcode\/\w{2}\/\w{2}\/\w{32}-1-SPLASH data-type=json data="{}" status-code=200

[Script]
哔哩哔哩-App = type=http-response, pattern=^https?:\/\/app\.bilibili\.com\/x\/v\d\/(?:feed\/index(?:\/story)?|search\/square|splash\/(?:brand\/list|event\/list2|list|show))\?, requires-body=1, max-size=0, script-path=OWN/modules/scripts/bilibili-adblock.js
哔哩哔哩-影視 = type=http-response, pattern=^https?:\/\/api\.bilibili\.com\/pgc\/page\/(?:bangumi|cinema\/tab\?), requires-body=1, max-size=0, script-path=OWN/modules/scripts/bilibili-adblock.js
哔哩哔哩-直播 = type=http-response, pattern=^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v\d\/index\/getInfoByRoom\?, requires-body=1, max-size=0, script-path=OWN/modules/scripts/bilibili-adblock.js

[MITM]
hostname = %APPEND% app.bilibili.com, api.bilibili.com, api.live.bilibili.com, upos-sz-static.bilivideo.com
